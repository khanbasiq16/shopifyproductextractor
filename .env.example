# Shopify Product Extractor - environment variables
# ------------------------------------------------------------------
# No API keys are required. The app only reads public storefront
# endpoints, so every variable below is optional and has a safe default.
# Copy this file to .env.local to override any value.

# Server: timeout (ms) for each outgoing request to a store.
REQUEST_TIMEOUT_MS=15000

# Client: pause (ms) between catalog page requests. Keeps request
# volume polite for the store. Minimum enforced value is 250.
NEXT_PUBLIC_REQUEST_DELAY_MS=600

# Client: maximum catalog pages to request (250 products per page).
# 100 pages = up to 25,000 products.
NEXT_PUBLIC_MAX_PAGES=100

# Client: maximum number of collections to map when
# "Include collections" is switched on.
NEXT_PUBLIC_MAX_COLLECTIONS=150
